# Bizuno production stack — environment template.
#
# Copy this file to `.env` in the same directory and fill in the values
# below. The file is read by docker-compose and substituted into the
# compose file + Caddyfile at container start.
#
#   cp .env.example .env
#   $EDITOR .env
#
# NEVER commit the populated .env to version control — it contains
# encryption keys and DB passwords.

# ─── Bizuno image version ───────────────────────────────────────────
# Pin to a specific release in production (e.g. 7.4.0). `latest` is
# convenient for ongoing test environments but will silently update on
# every `docker compose pull`.
BIZUNO_VERSION=latest

# ─── Hostname Bizuno serves at ──────────────────────────────────────
# Public FQDN. The cert below must be valid for this name (wildcard
# certs covering *.your-domain.com work fine).
BIZUNO_HOSTNAME=ww5.phreesoft.com

# ─── TLS cert paths on the host ─────────────────────────────────────
# Both files must exist on the Docker host BEFORE `docker compose up`.
# The /etc/ssl/docker/ directory is bind-mounted read-only into the
# caddy container at the same path, so values here are interpreted as
# host paths.
CADDY_CERT_FILE=/etc/ssl/docker/star.phreesoft.com.pem
CADDY_KEY_FILE=/etc/ssl/docker/star.phreesoft.com.key

# ─── Per-install Bizuno secrets ─────────────────────────────────────
# BIZUNO_KEY — 16 alphanumeric characters. Encrypts stored PII
# (passwords, SMTP creds, payment-gateway tokens). CRITICAL TO PRESERVE
# across container rebuilds; rotating it makes all encrypted data
# unreadable. Generate once, store in your password manager, also keep
# portalCFG.php backed up.
#   Generate one:  openssl rand -base64 16 | tr -dc 'A-Za-z0-9' | head -c16
BIZUNO_KEY=REPLACE_ME_WITH_16_ALPHANUMERIC_CHARS

# BIZUNO_BIZID — 6 alphanumeric chars, multi-business identifier
# (used as a directory prefix in BIZUNO_DATA). Pick once, leave alone.
#   Generate one:  openssl rand -base64 6 | tr -dc 'A-Za-z0-9' | head -c6
BIZUNO_BIZID=REPLACE6

# ─── Database credentials ───────────────────────────────────────────
# These get created automatically in the mariadb container on first
# boot. Used by both the bizuno container (to connect) and the mariadb
# container (to grant access).
BIZUNO_DB_NAME=bizuno
BIZUNO_DB_USER=bizuno
# Generate one:  openssl rand -base64 24
BIZUNO_DB_PASS=REPLACE_ME_WITH_STRONG_DB_PASSWORD

# MariaDB root password — used only by the mariadb container's own
# admin tasks. Bizuno doesn't use this. Still: pick a strong value.
# Generate one:  openssl rand -base64 24
MARIADB_ROOT_PASSWORD=REPLACE_ME_WITH_STRONG_ROOT_PASSWORD
